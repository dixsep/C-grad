{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++ build C-grad",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-std=c++17",
                "-Wall",
                "${workspaceFolder}/Autograd/Value.cpp",
                "${workspaceFolder}/Autograd/Neuron.cpp",
                "${workspaceFolder}/Autograd/Layer.cpp",
                "${workspaceFolder}/Autograd/MLP.cpp",
                "${workspaceFolder}/Autograd/test.cpp",
                "-I${workspaceFolder}/Autograd",
                "-o",
                "${workspaceFolder}/Autograd/test"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Build all Autograd sources"
        }
    ],
    "version": "2.0.0"
}
